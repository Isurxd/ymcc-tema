rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is a verified Admin/Operator
    function isStaff() {
      return request.auth != null && (
        request.auth.token.email in ["m.fairuzadhimularifin@gmail.com", "suryatripatih@gmail.com", "noreply@ymccvii.com"] ||
        (
          exists(/databases/$(database)/documents/staff_applications/$(request.auth.token.email)) &&
          get(/databases/$(database)/documents/staff_applications/$(request.auth.token.email)).data.status == "APPROVED"
        )
      );
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if isStaff();
    }

    match /staff_applications/{emailId} {
      allow read, write: if request.auth != null && request.auth.token.email == emailId;
      allow read, write: if isStaff();
    }

    match /activities/{document=**} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /news/{document=**} {
      allow read: if true;
      allow write: if isStaff();
    }
    
    match /sponsors/{document=**} {
      allow read: if true;
      allow write: if isStaff();
    }
    
    match /faqs/{document=**} {
      allow read: if true;
      allow write: if isStaff();
    }
    
    match /competition_documents/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if isStaff();
    }

    match /merchandise/{document=**} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /orders/{document=**} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /Orders/{orderId} {
      allow read: if isStaff() || (request.auth != null && resource.data.userDetails.email == request.auth.token.email);
      allow write: if isStaff() || (request.auth != null && request.resource.data.userDetails.email == request.auth.token.email);
    }

    match /Inventory_Locks/{document=**} {
      allow read: if true;
      allow write: if request.auth != null || isStaff();
    }

    match /subscribers/{document=**} {
      allow read: if isStaff();
      allow write: if true;
    }

    match /newsFeedback/{document=**} {
      allow read: if isStaff();
      allow write: if true;
    }

    match /activityClicks/{document=**} {
      allow read: if isStaff();
      allow write: if true;
    }

    match /merch_banners/{document=**} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /broadcasts/{document=**} {
      allow read, write: if isStaff();
    }

    match /support_tickets/{document=**} {
      allow read, write: if isStaff() || request.auth != null;
    }

    match /audit_logs/{document=**} {
      allow read, write: if isStaff();
    }

    match /promos/{document=**} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /affiliate_applications/{document=**} {
      allow read: if isStaff();
      allow write: if true;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
