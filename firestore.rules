rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is a verified Admin/Operator
    function isStaff() {
      return request.auth != null && (
        request.auth.token.email in ["m.fairuzadhimularifin@gmail.com", "suryatripatih@gmail.com", "noreply@ymccvii.com"] ||
        (
          exists(/databases/$(database)/documents/staff_applications/$(request.auth.token.email)) &&
          get(/databases/$(database)/documents/staff_applications/$(request.auth.token.email)).data.status == "APPROVED"
        )
      );
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if (request.auth != null && request.auth.uid == userId) || isStaff();
    }

    match /staff_applications/{emailId} {
      // Users can only read their own application
      allow read: if request.auth != null && request.auth.token.email == emailId;
      // FIX 1 (SANGAT KRITIS): Prevent "God-Mode" exploit.
      // Users can only CREATE an application with status PENDING. They cannot UPDATE it to APPROVED.
      allow create: if request.auth != null && request.auth.token.email == emailId && request.resource.data.status == "PENDING";
      allow read, update, delete: if isStaff();
    }

    match /activities/{document=**} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /news/{document=**} {
      allow read: if true;
      allow write: if isStaff();
    }
    
    match /sponsors/{document=**} {
      allow read: if true;
      allow write: if isStaff();
    }
    
    match /faqs/{document=**} {
      allow read: if true;
      allow write: if isStaff();
    }
    
    match /competition_documents/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if isStaff();
    }

    match /merchandise/{document=**} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /orders/{document=**} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /Orders/{orderId} {
      // FIX 2 (KRITIS): Prevent Payment Bypass.
      // Users can read their own orders, but CANNOT write/update their orders directly!
      // All order creation and status updates MUST go through the secure backend (Xendit webhook).
      allow read: if isStaff() || (request.auth != null && resource.data.userDetails.email == request.auth.token.email);
      allow write: if isStaff();
    }

    match /Inventory_Locks/{document=**} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /subscribers/{document=**} {
      allow read: if isStaff();
      allow create: if true;
      allow update, delete: if isStaff();
    }

    match /newsFeedback/{document=**} {
      allow read: if isStaff();
      allow create: if true;
      allow update, delete: if isStaff();
    }

    match /activityClicks/{document=**} {
      allow read: if isStaff();
      allow create, update: if true;
      allow delete: if isStaff();
    }

    match /merch_banners/{document=**} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /broadcasts/{document=**} {
      allow read, write: if isStaff();
    }

    match /support_tickets/{document=**} {
      // FIX 3: Prevent Data Tampering.
      // Users can only read and create their own tickets. They cannot read or delete others.
      allow read: if isStaff() || (request.auth != null && resource.data.email == request.auth.token.email);
      allow create: if request.auth != null && request.resource.data.email == request.auth.token.email;
      allow update, delete: if isStaff();
    }

    match /audit_logs/{document=**} {
      allow read, write: if isStaff();
    }

    match /promos/{document=**} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /affiliate_applications/{document=**} {
      allow read: if isStaff();
      // FIX 4: Prevent Data Destruction.
      // Anyone can submit (create) an application, but they cannot update or delete existing applications!
      allow create: if true;
      allow update, delete: if isStaff();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
